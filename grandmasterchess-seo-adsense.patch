diff -ruN --strip-trailing-cr -x node_modules -x .next -x .git repo/components/LanguageSwitcher.tsx site/components/LanguageSwitcher.tsx
--- repo/components/LanguageSwitcher.tsx	1970-01-01 00:00:00.000000000 +0000
