+'use client';
+
+import React, { useEffect, useMemo, useState } from 'react';
+import { ArrowLeftRight, RefreshCw } from 'lucide-react';
+import { convert, currencyName, formatCurrency, type RatesPayload } from '@/lib/currency';
+
+const POPULAR = ['USD', 'EUR', 'INR', 'GBP', 'JPY', 'AUD', 'CAD', 'CHF', 'CNY', 'SGD'];
+const AMOUNTS = [1, 10, 100, 1000, 10000];
+
+async function fetchRates(): Promise<RatesPayload> {
+  const res = await fetch('/api/rates');
+  if (!res.ok) throw new Error('unavailable');
+  return (await res.json()) as RatesPayload;
+}
+
+const field =
+  'w-full rounded-lg border border-[#3c3934] bg-[#262421] px-3 py-2.5 text-sm text-zinc-100 focus:border-[#81b64c] focus:outline-none';
+const label = 'mb-1 block text-xs font-bold uppercase tracking-wider text-zinc-400';
+
+export const CurrencyConverter: React.FC = () => {
+  const [data, setData] = useState<RatesPayload | null>(null);
+  const [status, setStatus] = useState<'loading' | 'ready' | 'error'>('loading');
+  const [amount, setAmount] = useState('100');
+  const [from, setFrom] = useState('USD');
+  const [to, setTo] = useState('INR');
+
+  useEffect(() => {
+    let cancelled = false;
+    fetchRates()
+      .then((d) => {
+        if (cancelled) return;
+        setData(d);
+        setStatus('ready');
+        // Fall back gracefully if the provider's list lacks a default currency.
+        setFrom((f) => (d.rates[f] ? f : 'EUR'));
+        setTo((t) => (d.rates[t] ? t : 'USD'));
+      })
+      .catch(() => !cancelled && setStatus('error'));
+    return () => {
+      cancelled = true;
+    };
+  }, []);
+
+  const retry = () => {
+    setStatus('loading');
+    fetchRates()
+      .then((d) => {
+        setData(d);
+        setStatus('ready');
+      })
+      .catch(() => setStatus('error'));
+  };
+
+  const options = useMemo(() => {
+    if (!data) return [];
+    const codes = Object.keys(data.rates);
+    const popular = POPULAR.filter((c) => codes.includes(c));
+    const rest = codes.filter((c) => !popular.includes(c)).sort();
+    return [...popular, ...rest].map((code) => ({ code, name: currencyName(code) }));
+  }, [data]);
+
+  const value = Number(amount.replace(/,/g, ''));
+  const valid = amount.trim() !== '' && Number.isFinite(value) && value >= 0;
+  const result = data && valid ? convert(value, from, to, data.rates) : null;
+  const unit = data ? convert(1, from, to, data.rates) : null;
+  const inverse = data ? convert(1, to, from, data.rates) : null;
+
+  return (
+    <div className="rounded-xl border border-[#3c3934] bg-[#1e1c19] p-4 sm:p-6">
+      {status === 'loading' && <p className="text-sm text-zinc-400" role="status">Loading the latest exchange rates...</p>}
+
+      {status === 'error' && (
+        <div role="alert" className="rounded-lg border border-[#3c3934] bg-[#161512] p-4 text-sm text-zinc-300">
+          Exchange rates are temporarily unavailable, so no conversion can be shown right now.
+          <button type="button" onClick={retry} className="ml-3 inline-flex items-center gap-1 rounded-lg border border-[#3c3934] bg-[#262421] px-3 py-1.5 text-xs font-semibold text-zinc-100 hover:border-[#81b64c]/60">
+            <RefreshCw className="h-3.5 w-3.5" /> Try again
+          </button>
+        </div>
+      )}
+
+      {status === 'ready' && data && (
+        <>
+          <div className="grid gap-4 sm:grid-cols-[1fr_1.4fr_auto_1.4fr] sm:items-end">
+            <div>
+              <label htmlFor="cc-amount" className={label}>Amount</label>
+              <input id="cc-amount" inputMode="decimal" value={amount} onChange={(e) => setAmount(e.target.value)} className={field} aria-invalid={!valid} />
+            </div>
+            <div>
+              <label htmlFor="cc-from" className={label}>From</label>
+              <select id="cc-from" value={from} onChange={(e) => setFrom(e.target.value)} className={field}>
+                {options.map((o) => <option key={o.code} value={o.code}>{o.code} - {o.name}</option>)}
+              </select>
+            </div>
+            <button type="button" aria-label="Swap currencies" onClick={() => { setFrom(to); setTo(from); }} className="mx-auto flex h-10 w-10 items-center justify-center rounded-lg border border-[#3c3934] bg-[#262421] text-zinc-200 hover:border-[#81b64c]/60">
+              <ArrowLeftRight className="h-4 w-4" />
+            </button>
+            <div>
+              <label htmlFor="cc-to" className={label}>To</label>
+              <select id="cc-to" value={to} onChange={(e) => setTo(e.target.value)} className={field}>
+                {options.map((o) => <option key={o.code} value={o.code}>{o.code} - {o.name}</option>)}
+              </select>
+            </div>
+          </div>
+
+          <div className="mt-6 rounded-lg border border-[#3c3934] bg-[#161512] p-4" aria-live="polite">
+            {!valid && <p className="text-sm text-zinc-400">Enter an amount of zero or more.</p>}
+            {valid && result !== null && (
+              <>
+                <p className="text-xs text-zinc-500">{formatCurrency(value, from)} equals</p>
+                <p className="text-3xl font-extrabold text-zinc-100" data-testid="cc-result">{formatCurrency(result, to)}</p>
+                {unit !== null && inverse !== null && (
+                  <p className="mt-2 text-xs text-zinc-400">
+                    1 {from} = {unit.toFixed(unit < 1 ? 6 : 4)} {to} &nbsp;|&nbsp; 1 {to} = {inverse.toFixed(inverse < 1 ? 6 : 4)} {from}
+                  </p>
+                )}
+              </>
+            )}
+            <p className="mt-2 text-[11px] text-zinc-500">ECB reference rates for {data.date}. Not the rate a bank or card will give you.</p>
+          </div>
+
+          {valid && unit !== null && (
+            <div className="mt-6 overflow-x-auto">
+              <table className="w-full max-w-md border border-[#3c3934] text-left text-xs">
+                <caption className="p-2 text-left text-zinc-400">Common amounts, {from} to {to}</caption>
+                <thead className="bg-[#262421] text-zinc-300"><tr><th className="p-2">{from}</th><th className="p-2">{to}</th></tr></thead>
+                <tbody>
+                  {AMOUNTS.map((a) => (
+                    <tr key={a} className="border-t border-[#3c3934]"><td className="p-2">{a.toLocaleString('en-US')}</td><td className="p-2">{(a * unit).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td></tr>
+                  ))}
+                </tbody>
+              </table>
+            </div>
+          )}
+        </>
+      )}
+    </div>
+  );
+};
diff -ruN --strip-trailing-cr -x node_modules -x .next -x .git repo/components/tools/EloCalculator.tsx site/components/tools/EloCalculator.tsx
--- repo/components/tools/EloCalculator.tsx	1970-01-01 00:00:00.000000000 +0000
+++ site/components/tools/EloCalculator.tsx	2026-10-23 16:45:05.441144591 +0000
@@ -0,0 +1,195 @@
+'use client';
+
+import React, { useMemo, useState } from 'react';
+import { Plus, Trash2 } from 'lucide-react';
+
+type Result = 'win' | 'draw' | 'loss';
+interface Game {
+  id: number;
+  opponent: number;
+  result: Result;
+}
+
+const SCORE: Record<Result, number> = { win: 1, draw: 0.5, loss: 0 };
+
+/** Expected score of a player rated `own` against `opp` (logistic Elo model, 400-point scale). */
+export function expectedScore(own: number, opp: number, capDifference: boolean): number {
+  let diff = opp - own;
+  if (capDifference) diff = Math.max(-400, Math.min(400, diff));
+  return 1 / (1 + Math.pow(10, diff / 400));
+}
+
+const inputCls =
+  'w-full rounded-lg border border-[#3c3934] bg-[#262421] px-3 py-2 text-sm text-zinc-100 focus:border-[#81b64c] focus:outline-none';
+const labelCls = 'block text-xs font-bold uppercase tracking-wider text-zinc-400 mb-1';
+
+function clampRating(n: number): number {
+  if (!Number.isFinite(n)) return 0;
+  return Math.max(0, Math.min(3500, Math.round(n)));
+}
+
+export const EloCalculator: React.FC = () => {
+  const [rating, setRating] = useState(1500);
+  const [kChoice, setKChoice] = useState<'40' | '20' | '10' | 'custom'>('20');
+  const [customK, setCustomK] = useState(24);
+  const [cap, setCap] = useState(true);
+  const [games, setGames] = useState<Game[]>([{ id: 1, opponent: 1700, result: 'win' }]);
+  const [nextId, setNextId] = useState(2);
+
+  const k = kChoice === 'custom' ? Math.max(1, Math.min(100, customK || 0)) : Number(kChoice);
+
+  const rows = useMemo(
+    () =>
+      games.map((g) => {
+        const e = expectedScore(rating, g.opponent, cap);
+        const s = SCORE[g.result];
+        return { ...g, expected: e, score: s, change: k * (s - e) };
+      }),
+    [games, rating, k, cap]
+  );
+
+  const totalChange = rows.reduce((acc, r) => acc + r.change, 0);
+  const totalExpected = rows.reduce((acc, r) => acc + r.expected, 0);
+  const totalScore = rows.reduce((acc, r) => acc + r.score, 0);
+  const newRating = rating + totalChange;
+
+  const updateGame = (id: number, patch: Partial<Game>) =>
+    setGames((gs) => gs.map((g) => (g.id === id ? { ...g, ...patch } : g)));
+
+  return (
+    <div className="rounded-xl border border-[#3c3934] bg-[#1e1c19] p-4 sm:p-6" aria-label="Elo rating calculator">
+      <div className="grid grid-cols-1 gap-4 sm:grid-cols-3">
+        <div>
+          <label htmlFor="elo-rating" className={labelCls}>Your rating</label>
+          <input
+            id="elo-rating"
+            type="number"
+            inputMode="numeric"
+            min={0}
+            max={3500}
+            value={rating}
+            onChange={(e) => setRating(clampRating(Number(e.target.value)))}
+            className={inputCls}
+          />
+        </div>
+        <div>
+          <label htmlFor="elo-k" className={labelCls}>K-factor</label>
+          <select
+            id="elo-k"
+            value={kChoice}
+            onChange={(e) => setKChoice(e.target.value as typeof kChoice)}
+            className={inputCls}
+          >
+            <option value="40">40: new players (first 30 games) and under-18s rated below 2300</option>
+            <option value="20">20: established players rated below 2400</option>
+            <option value="10">10: players whose rating has reached 2400</option>
+            <option value="custom">Custom (e.g. a club or online site)</option>
+          </select>
+          {kChoice === 'custom' && (
+            <input
+              aria-label="Custom K-factor"
+              type="number"
+              min={1}
+              max={100}
+              value={customK}
+              onChange={(e) => setCustomK(Number(e.target.value))}
+              className={`${inputCls} mt-2`}
+            />
+          )}
+        </div>
+        <div className="flex items-end">
+          <label className="flex items-center gap-2 text-xs text-zinc-300">
+            <input type="checkbox" checked={cap} onChange={(e) => setCap(e.target.checked)} className="h-4 w-4 accent-[#81b64c]" />
+            Count rating gaps above 400 as 400 (FIDE rule)
+          </label>
+        </div>
+      </div>
+
+      <div className="mt-6">
+        <p className={labelCls}>Games</p>
+        <div className="space-y-2">
+          {rows.map((r, i) => (
+            <div key={r.id} className="grid grid-cols-12 items-center gap-2">
+              <span className="col-span-1 text-xs text-zinc-500">{i + 1}</span>
+              <div className="col-span-4 sm:col-span-3">
+                <input
+                  aria-label={`Opponent rating, game ${i + 1}`}
+                  type="number"
+                  inputMode="numeric"
+                  min={0}
+                  max={3500}
+                  value={r.opponent}
+                  onChange={(e) => updateGame(r.id, { opponent: clampRating(Number(e.target.value)) })}
+                  className={inputCls}
+                />
+              </div>
+              <div className="col-span-4 sm:col-span-3">
+                <select
+                  aria-label={`Result, game ${i + 1}`}
+                  value={r.result}
+                  onChange={(e) => updateGame(r.id, { result: e.target.value as Result })}
+                  className={inputCls}
+                >
+                  <option value="win">Win</option>
+                  <option value="draw">Draw</option>
+                  <option value="loss">Loss</option>
+                </select>
+              </div>
+              <div className="col-span-2 hidden text-right text-xs text-zinc-400 sm:block">E = {r.expected.toFixed(2)}</div>
+              <div className={`col-span-2 text-right text-sm font-bold ${r.change >= 0 ? 'text-[#81b64c]' : 'text-red-400'}`}>
+                {r.change >= 0 ? '+' : ''}
+                {r.change.toFixed(1)}
+              </div>
+              <button
+                type="button"
+                aria-label={`Remove game ${i + 1}`}
+                onClick={() => setGames((gs) => (gs.length > 1 ? gs.filter((g) => g.id !== r.id) : gs))}
+                className="col-span-1 flex justify-end text-zinc-500 hover:text-red-400 disabled:opacity-30"
+                disabled={games.length === 1}
+              >
+                <Trash2 className="h-4 w-4" />
+              </button>
+            </div>
+          ))}
+        </div>
+        <button
+          type="button"
+          onClick={() => {
+            setGames((gs) => [...gs, { id: nextId, opponent: rating, result: 'draw' }]);
+            setNextId((n) => n + 1);
+          }}
+          disabled={games.length >= 20}
+          className="mt-3 inline-flex items-center gap-1.5 rounded-lg border border-[#3c3934] bg-[#262421] px-3 py-2 text-xs font-bold text-zinc-100 hover:border-[#81b64c]/50 disabled:opacity-40"
+        >
+          <Plus className="h-3.5 w-3.5" /> Add game
+        </button>
+      </div>
+
+      <div className="mt-6 grid grid-cols-1 gap-3 rounded-lg border border-[#3c3934] bg-[#161512] p-4 sm:grid-cols-3" aria-live="polite">
+        <div>
+          <p className="text-[11px] uppercase tracking-wider text-zinc-500">Expected score</p>
+          <p className="text-lg font-bold text-zinc-100">
+            {totalExpected.toFixed(2)} <span className="text-xs font-normal text-zinc-500">of {games.length}</span>
+          </p>
+        </div>
+        <div>
+          <p className="text-[11px] uppercase tracking-wider text-zinc-500">Actual score</p>
+          <p className="text-lg font-bold text-zinc-100">{totalScore.toFixed(1)}</p>
+        </div>
+        <div>
+          <p className="text-[11px] uppercase tracking-wider text-zinc-500">New rating</p>
+          <p className="text-lg font-bold text-zinc-100">
+            {newRating.toFixed(1)}{' '}
+            <span className={`text-sm ${totalChange >= 0 ? 'text-[#81b64c]' : 'text-red-400'}`}>
+              ({totalChange >= 0 ? '+' : ''}
+              {totalChange.toFixed(1)})
+            </span>
+          </p>
+        </div>
+      </div>
+      <p className="mt-3 text-xs text-zinc-500">
+        Change = K × (score − expected score), summed over the games. All games are rated from your starting rating, as in a single rating period.
+      </p>
+    </div>
+  );
+};
