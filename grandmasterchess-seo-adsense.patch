diff -ruN --strip-trailing-cr -x node_modules -x .next -x .git repo/app/editorial-policy/page.tsx site/app/editorial-policy/page.tsx
--- repo/app/editorial-policy/page.tsx	1970-01-01 00:00:00.000000000 +0000
