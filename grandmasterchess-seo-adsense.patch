@@ -0,0 +1,52 @@
+/** Currency conversion helpers. Rates are euro-based (ECB reference rates), so any pair is a cross rate through EUR. */
+export interface RatesPayload {
+  base: 'EUR';
+  date: string;
+  /** Units of each currency per 1 EUR, including EUR itself (= 1). */
+  rates: Record<string, number>;
+}
+
+/** Validates the Frankfurter /v1/latest response ({ amount, base, date, rates }) and normalises it to a EUR-based payload. */
+export function parseRatesResponse(json: unknown): RatesPayload | null {
+  if (!json || typeof json !== 'object') return null;
+  const j = json as { base?: unknown; date?: unknown; rates?: unknown };
+  if (j.base !== 'EUR' || typeof j.date !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(j.date)) return null;
+  if (!j.rates || typeof j.rates !== 'object') return null;
+  const rates: Record<string, number> = { EUR: 1 };
+  for (const [code, v] of Object.entries(j.rates as Record<string, unknown>)) {
+    if (/^[A-Z]{3}$/.test(code) && typeof v === 'number' && Number.isFinite(v) && v > 0) rates[code] = v;
+  }
+  if (Object.keys(rates).length < 5) return null;
+  return { base: 'EUR', date: j.date, rates };
+}
+
+export function convert(amount: number, from: string, to: string, rates: Record<string, number>): number | null {
+  const a = rates[from];
+  const b = rates[to];
+  if (!Number.isFinite(amount) || !a || !b) return null;
+  return (amount / a) * b;
+}
+
+/** English currency name via the platform's own data (no hard-coded list), falling back to the code. */
+export function currencyName(code: string): string {
+  try {
+    return new Intl.DisplayNames(['en'], { type: 'currency' }).of(code) ?? code;
+  } catch {
+    return code;
+  }
+}
+
+export function formatCurrency(amount: number, code: string): string {
+  const big = Math.abs(amount) >= 1;
+  try {
+    return new Intl.NumberFormat('en-US', {
+      style: 'currency',
+      currency: code,
+      currencyDisplay: 'code',
+      minimumFractionDigits: big ? 2 : 4,
+      maximumFractionDigits: big ? 2 : 6,
+    }).format(amount);
+  } catch {
+    return `${amount.toFixed(2)} ${code}`;
+  }
+}
diff -ruN --strip-trailing-cr -x node_modules -x .next -x .git repo/lib/emi.ts site/lib/emi.ts
--- repo/lib/emi.ts	1970-01-01 00:00:00.000000000 +0000
+++ site/lib/emi.ts	2026-10-25 13:37:29.033296327 +0000
@@ -0,0 +1,103 @@
+/**
+ * EMI (equated monthly instalment) maths for a reducing-balance loan.
+ * Works in whole paise/cents so the schedule adds up exactly and the final payment absorbs rounding.
+ */
+export interface EmiInput {
+  principal: number;
+  annualRatePct: number;
+  months: number;
+}
+
+export interface ScheduleRow {
+  month: number;
+  payment: number;
+  principal: number;
+  interest: number;
+  balance: number;
+}
+
+export interface YearSummary {
+  year: number;
+  principal: number;
+  interest: number;
+  balance: number;
+}
+
+export interface EmiResult {
+  emi: number;
+  totalInterest: number;
+  totalPayment: number;
+  schedule: ScheduleRow[];
+  years: YearSummary[];
+}
+
+export const LIMITS = { maxPrincipal: 1_000_000_000_000, maxRate: 100, maxMonths: 600 } as const;
+
+export function validateEmi(i: EmiInput): string | null {
+  if (!Number.isFinite(i.principal) || i.principal <= 0) return 'Enter a loan amount greater than zero.';
+  if (i.principal > LIMITS.maxPrincipal) return 'That loan amount is too large to calculate.';
+  if (!Number.isFinite(i.annualRatePct) || i.annualRatePct < 0) return 'Enter an interest rate of zero or more.';
+  if (i.annualRatePct > LIMITS.maxRate) return `Enter an interest rate of ${LIMITS.maxRate}% or less.`;
+  if (!Number.isInteger(i.months) || i.months < 1) return 'Enter a loan tenure of at least one month.';
+  if (i.months > LIMITS.maxMonths) return `Enter a tenure of ${LIMITS.maxMonths / 12} years (${LIMITS.maxMonths} months) or less.`;
+  return null;
+}
+
+/** Monthly instalment before rounding: P*r*(1+r)^n / ((1+r)^n - 1), or P/n at 0% interest. */
+export function rawEmi(principal: number, annualRatePct: number, months: number): number {
+  const r = annualRatePct / 12 / 100;
+  if (r === 0) return principal / months;
+  const growth = Math.pow(1 + r, months);
+  return (principal * r * growth) / (growth - 1);
+}
+
+export function calculateEmi(input: EmiInput): EmiResult | null {
+  if (validateEmi(input) !== null) return null;
+  const { principal, annualRatePct, months } = input;
+  const r = annualRatePct / 12 / 100;
+  const P = Math.round(principal * 100); // paise
+  const emiPaise = Math.round(rawEmi(principal, annualRatePct, months) * 100);
+
+  const schedule: ScheduleRow[] = [];
+  let balance = P;
+  let totalPaid = 0;
+  for (let m = 1; m <= months; m++) {
+    const interest = Math.round(balance * r);
+    // The last instalment clears whatever is left, absorbing rounding differences.
+    const principalPart = m === months ? balance : Math.min(balance, emiPaise - interest);
+    const payment = principalPart + interest;
+    balance -= principalPart;
+    totalPaid += payment;
+    schedule.push({ month: m, payment: payment / 100, principal: principalPart / 100, interest: interest / 100, balance: balance / 100 });
+  }
+
+  const years: YearSummary[] = [];
+  for (let y = 0; y * 12 < months; y++) {
+    const rows = schedule.slice(y * 12, y * 12 + 12);
+    years.push({
+      year: y + 1,
+      principal: round2(rows.reduce((a, x) => a + x.principal, 0)),
+      interest: round2(rows.reduce((a, x) => a + x.interest, 0)),
+      balance: rows[rows.length - 1].balance,
+    });
+  }
+
+  return {
+    emi: emiPaise / 100,
+    totalInterest: (totalPaid - P) / 100,
+    totalPayment: totalPaid / 100,
+    schedule,
+    years,
+  };
+}
+
+const round2 = (n: number) => Math.round(n * 100) / 100;
+
+const LOCALES: Record<string, string> = { INR: 'en-IN', USD: 'en-US', GBP: 'en-GB', EUR: 'en-IE', NONE: 'en-US' };
+
+/** Formats an amount for a currency choice ("INR", "USD", "GBP", "EUR") or as a plain number ("NONE"). */
+export function formatMoney(amount: number, currency: string): string {
+  const locale = LOCALES[currency] ?? 'en-US';
+  if (currency === 'NONE') return new Intl.NumberFormat(locale, { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(amount);
+  return new Intl.NumberFormat(locale, { style: 'currency', currency, minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(amount);
+}
diff -ruN --strip-trailing-cr -x node_modules -x .next -x .git repo/lib/fen-diagram.ts site/lib/fen-diagram.ts
--- repo/lib/fen-diagram.ts	1970-01-01 00:00:00.000000000 +0000
+++ site/lib/fen-diagram.ts	2026-10-25 07:54:53.896771059 +0000
@@ -0,0 +1,102 @@
+import { Chess } from 'chess.js';
+
+/**
+ * Renders ```fen code blocks from blog markdown as inline SVG chess diagrams.
+ *
+ * Block format (one line):   <FEN> | <caption> | hl=e4,e5
+ *   - FEN: full FEN, or just the piece-placement field (side to move defaults to white).
+ *   - caption: shown under the board and used as the SVG accessible name.
+ *   - hl=...: optional comma list of squares to highlight.
+ *
+ * Illegal FENs throw at build time so a bad diagram can never be published.
+ */
+
+const GLYPH: Record<string, string> = {
+  K: '\u2654', Q: '\u2655', R: '\u2656', B: '\u2657', N: '\u2658', P: '\u2659',
+  k: '\u265A', q: '\u265B', r: '\u265C', b: '\u265D', n: '\u265E', p: '\u265F',
+};
+
+const FILES = 'abcdefgh';
+
+function esc(s: string): string {
+  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
+}
+
+function unesc(s: string): string {
+  return s.replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&amp;/g, '&');
+}
+
+export interface BoardSvgOptions {
+  highlights?: string[];
+  flip?: boolean;
+  /** Accessible name for the SVG. */
+  label?: string;
+}
+
+/** Just the <svg> element for a position (used by the figure wrapper and by interactive tools). */
+export function fenToBoardSvg(fenInput: string, opts: BoardSvgOptions = {}): { svg: string; turn: 'White' | 'Black'; fen: string } {
+  const fen = fenInput.trim().split(/\s+/).length === 1 ? `${fenInput.trim()} w - - 0 1` : fenInput.trim();
+  // Validates piece placement and basic legality; throws on a bad FEN.
+  const game = new Chess(fen);
+  const board = game.board();
+  const flip = !!opts.flip;
+  const S = 40; // square size
+  const M = 16; // margin for coordinates
+  const size = S * 8 + M * 2;
+  const hl = new Set((opts.highlights ?? []).map((h) => h.trim().toLowerCase()).filter(Boolean));
+
+  let squares = '';
+  let pieces = '';
+  for (let r = 0; r < 8; r++) {
+    for (let f = 0; f < 8; f++) {
+      const rr = flip ? 7 - r : r; // board row shown at screen row r
+      const ff = flip ? 7 - f : f;
+      const x = M + f * S;
+      const y = M + r * S;
+      const light = (rr + ff) % 2 === 0;
+      const sq = `${FILES[ff]}${8 - rr}`;
+      const fill = hl.has(sq) ? '#e8c547' : light ? '#eeeed2' : '#769656';
+      squares += `<rect x="${x}" y="${y}" width="${S}" height="${S}" fill="${fill}"/>`;
+      const piece = board[rr][ff];
+      if (piece) {
+        const key = piece.color === 'w' ? piece.type.toUpperCase() : piece.type;
+        const isWhite = piece.color === 'w';
+        pieces += `<text x="${x + S / 2}" y="${y + S * 0.76}" font-size="${S * 0.82}" text-anchor="middle" fill="${isWhite ? '#ffffff' : '#111111'}" stroke="${isWhite ? '#111111' : '#ffffff'}" stroke-width="${isWhite ? 0.9 : 0.4}" paint-order="stroke" font-family="'Segoe UI Symbol','Noto Sans Symbols 2','DejaVu Sans',serif">${GLYPH[key]}</text>`;
+      }
+    }
+  }
+  let coords = '';
+  for (let i = 0; i < 8; i++) {
+    coords += `<text x="${M + i * S + S / 2}" y="${size - 4}" font-size="10" text-anchor="middle" fill="#a1a1aa">${FILES[flip ? 7 - i : i]}</text>`;
+    coords += `<text x="5" y="${M + i * S + S / 2 + 3}" font-size="10" text-anchor="middle" fill="#a1a1aa">${flip ? i + 1 : 8 - i}</text>`;
+  }
+  const turn = game.turn() === 'w' ? 'White' : 'Black';
+  const label = `${opts.label || 'Chess position'} (${turn} to move)`;
+  const svg =
+    `<svg viewBox="0 0 ${size} ${size}" role="img" aria-label="${esc(label)}" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;border-radius:6px;background:#262421">` +
+    `<title>${esc(label)}</title>${squares}${pieces}${coords}</svg>`;
+  return { svg, turn, fen };
+}
+
+export function fenToSvg(fenInput: string, caption: string, highlights: string[] = []): string {
+  const { svg, turn, fen } = fenToBoardSvg(fenInput, { highlights, label: caption });
+  return (
+    `<figure class="chess-diagram" style="margin:1.5rem auto;max-width:360px">` +
+    svg +
+    `<figcaption style="margin-top:.5rem;font-size:.8rem;color:#a1a1aa;text-align:center">${esc(caption)}${caption ? ' ' : ''}<span style="color:#71717a">${turn} to move. FEN: <code>${esc(fen)}</code></span></figcaption>` +
+    `</figure>`
+  );
+}
+
+/** Replace <pre><code class="language-fen">…</code></pre> (as produced by remark-html) with SVG figures. */
+export function renderFenBlocks(html: string): string {
+  return html.replace(
+    /<pre><code class="language-fen">([\s\S]*?)<\/code><\/pre>/g,
+    (_m, body: string) => {
+      const line = unesc(body).trim();
+      const [fen, caption = '', extra = ''] = line.split('|').map((p) => p.trim());
+      const hl = extra.toLowerCase().startsWith('hl=') ? extra.slice(3).split(',') : [];
+      return fenToSvg(fen, caption, hl);
+    }
+  );
+}
