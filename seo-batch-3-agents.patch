+import type { Metadata } from 'next';
+import Link from 'next/link';
+import { Bot } from 'lucide-react';
+import { pageMetadata } from '@/lib/seo';
+import { jsonLdGraph, breadcrumbSchema, personSchema } from '@/lib/json-ld';
+import { SITE_URL } from '@/lib/site-config';
+import { toolLink } from '@/lib/deeplinks';
+import { calculateEmi, formatMoney } from '@/lib/emi';
+
+export const metadata: Metadata = pageMetadata({
+  title: 'For AI Assistants and Developers: MCP and Tool Links',
+  description:
+    'How AI assistants and developers can use Grandmasterchess: the MCP server and its tools, prefilled tool links, the sitemap, and how to cite our articles.',
+  path: '/agents',
+  absoluteTitle: true,
+  ogLabel: 'Developers',
+});
+
+const H2 = 'mb-2 text-lg font-bold text-zinc-100';
+const A = 'text-[#81b64c] hover:underline';
+const CODE = 'rounded bg-[#262421] px-1.5 py-0.5 text-[#81b64c] break-all';
+
+const STATELESS_TOOLS: [string, string][] = [
+  ['search_chess_content', 'Search the published articles; returns matching pages with URLs, updated dates and checked-on dates.'],
+  ['get_chess_article', 'Get one article by slug, with its sources, dates and a ready-made citation line.'],
+  ['find_opening', 'A short reference for a chess opening, with related articles.'],
+  ['get_chess_rules', 'A concise rules reference (moves, castling, en passant, promotion, draws).'],
+  ['get_chess_puzzle', 'A practice position (FEN) for a chosen tactical theme.'],
+  ['list_legal_moves', 'Every legal move from a FEN, in SAN and UCI, optionally for one square.'],
+  ['apply_chess_move', 'Apply one move (SAN or UCI) to a FEN and get the new FEN and game status.'],
+  ['analyze_chess_position', 'Stockfish analysis of a FEN: best move, evaluation and main line.'],
+  ['coach_chess_move', 'Stockfish comparison of the position before and after a move, with a classification.'],
+];
+const STATEFUL_TOOLS: [string, string][] = [
+  ['new_chess_game / start_ai_chess_game / play_chess_vs_ai', 'Start or continue a game kept in server memory (the AI opponent is Stockfish).'],
+  ['make_chess_move / get_chess_game / get_legal_chess_moves / analyze_chess_game', 'Work with a game created above, using its game id.'],
+];
+
+export default function AgentsPage() {
+  const emi = calculateEmi({ principal: 500000, annualRatePct: 9, months: 60 })!;
+  const links: [string, string, string][] = [
+    ['EMI calculator', toolLink('/tools/emi-calculator', { amount: 500000, rate: 9, years: 5 }), `amount, rate (% a year), years or months, currency (INR, USD, GBP, EUR). This example shows an EMI of ${formatMoney(emi.emi, 'INR')}.`],
+    ['Currency converter', toolLink('/tools/currency-converter', { amount: 100, from: 'USD', to: 'INR' }), 'amount, from and to (three-letter currency codes). The result and the date of the rates are in the page itself.'],
+    ['PGN and FEN viewer', toolLink('/tools/pgn-viewer', { pgn: '1. e4 e5 2. Nf3 Nc6 3. Bb5' }), 'pgn (a game) or fen (a position), up to 8,000 characters. Steps through the moves on a board.'],
+  ];
+  const graph = jsonLdGraph(
+    personSchema(),
+    breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'For AI Assistants', path: '/agents' }])
+  );
+  return (
+    <div className="mx-auto max-w-4xl px-4 py-10 sm:px-6">
+      <script type="application/ld+json" dangerouslySetInnerHTML={{ __html: JSON.stringify(graph) }} />
+      <div className="mb-2 flex items-center gap-3">
+        <div className="flex h-9 w-9 items-center justify-center rounded-lg bg-[#81b64c] text-zinc-950"><Bot className="h-5 w-5" /></div>
+        <h1 className="text-2xl font-extrabold text-zinc-100 sm:text-3xl">For AI Assistants and Developers</h1>
+      </div>
+      <p className="mb-8 text-sm text-zinc-400">
+        Grandmasterchess is designed to be read and used by AI assistants as well as people. This page lists what is available, how to connect, and how to
+        cite us.
+      </p>
+
+      <div className="space-y-8 text-sm leading-relaxed text-zinc-300">
+        <section>
+          <h2 className={H2}>Reading the site</h2>
+          <ul className="list-disc space-y-1 pl-5">
+            <li>Pages are served as complete HTML and do not need JavaScript to be read.</li>
+            <li>Crawling is allowed, except for <code className={CODE}>/api/</code> and <code className={CODE}>/dashboard</code>. See <a className={A} href="/robots.txt">robots.txt</a>.</li>
+            <li>Find pages through the <a className={A} href="/sitemap.xml">sitemap</a>, the <a className={A} href="/feed.xml">RSS feed</a> and <a className={A} href="/llms.txt">llms.txt</a>.</li>
+            <li>Articles start with a short answer, list their sources at the bottom and show a &quot;checked on&quot; date. Ratings, rankings and schedules change, so treat a figure as correct only as of that date.</li>
+            <li>When you use our content, please cite and link the page, for example &quot;Grandmasterchess (https://www.grandmasterchess.in/blog/what-elo-is-a-grandmaster)&quot;.</li>
+          </ul>
+        </section>
+
+        <section>
+          <h2 className={H2}>MCP server</h2>
+          <p className="mb-2">
+            Any assistant that supports remote MCP servers can connect to <code className={CODE}>{SITE_URL}/api/mcp</code> (Streamable HTTP). No sign-in is needed. A
+            health check is at <code className={CODE}>/api/mcp/health</code>.
+          </p>
+          <h3 className="mb-1 mt-4 font-bold text-zinc-100">Tools that need no saved game (preferred)</h3>
+          <div className="overflow-x-auto">
+            <table className="w-full border border-[#3c3934] text-left text-xs">
+              <tbody>
+                {STATELESS_TOOLS.map(([n, d]) => (
+                  <tr key={n} className="border-t border-[#3c3934] align-top first:border-t-0"><td className="p-2 font-mono text-[#81b64c]">{n}</td><td className="p-2">{d}</td></tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+          <h3 className="mb-1 mt-4 font-bold text-zinc-100">Tools that keep a game in server memory</h3>
+          <div className="overflow-x-auto">
+            <table className="w-full border border-[#3c3934] text-left text-xs">
+              <tbody>
+                {STATEFUL_TOOLS.map(([n, d]) => (
+                  <tr key={n} className="border-t border-[#3c3934] align-top first:border-t-0"><td className="p-2 font-mono text-[#81b64c]">{n}</td><td className="p-2">{d}</td></tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+          <p className="mt-3">
+            Saved games live in the server&apos;s memory and can be lost between requests, so for reliable play pass the position as a FEN to{' '}
+            <code className={CODE}>apply_chess_move</code> and keep the FEN yourself. The engine behind these tools is Stockfish. The games on the website use a
+            different, home-built engine that is much weaker (see <Link href="/about" className={A}>About</Link>).
+          </p>
+        </section>
+
+        <section>
+          <h2 className={H2}>Prefilled tool links</h2>
+          <p className="mb-2">These links open a tool with values already filled in, so an assistant can give a person a link that shows the answer.</p>
+          <div className="space-y-3">
+            {links.map(([name, href, note]) => (
+              <div key={name} className="rounded-lg border border-[#3c3934] bg-[#1e1c19] p-3">
+                <p className="font-bold text-zinc-100">{name}</p>
+                <p className="mt-1"><a className={A} href={href}><code className={CODE}>{href}</code></a></p>
+                <p className="mt-1 text-xs text-zinc-400">{note}</p>
+              </div>
+            ))}
+          </div>
+          <p className="mt-2 text-xs text-zinc-500">Values are validated; anything that is not a plain number, a short code or a game is ignored.</p>
+        </section>
+
+        <section>
+          <h2 className={H2}>Browser-based agents</h2>
+          <p>
+            The chessboard can be used without a mouse. Each square has a spoken name such as &quot;e4, white pawn&quot;, the arrow keys move between squares,
+            Enter or Space selects and moves, Escape cancels, and the last move and whose turn it is are announced. Tools use labelled form fields.
+          </p>
+        </section>
+
+        <section>
+          <h2 className={H2}>Fair use</h2>
+          <p>
+            Please keep request rates reasonable. Engine analysis is the most expensive call. We may slow or block traffic that harms the site. Questions or
+            corrections: <Link href="/contact" className={A}>contact us</Link> or see the <Link href="/editorial-policy" className={A}>editorial policy</Link>.
+          </p>
+        </section>
+      </div>
+    </div>
+  );
+}
