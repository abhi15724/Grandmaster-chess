+/**
+ * Prefilled tool links, e.g. /tools/emi-calculator?amount=500000&rate=9&years=5.
+ * Every value is validated here, so a crafted link can only ever set plain numbers, short codes or a size-limited text.
+ */
+export type SearchParams = Record<string, string | string[] | undefined>;
+
+const first = (v: string | string[] | undefined): string | undefined => (Array.isArray(v) ? v[0] : v);
+const NUMBER = /^[0-9][0-9,]{0,14}(\.[0-9]{1,6})?$/;
+const SMALL_NUMBER = /^[0-9]{1,3}(\.[0-9]{1,4})?$/;
+
+export interface EmiInitial {
+  amount?: string;
+  rate?: string;
+  tenure?: string;
+  unit?: 'years' | 'months';
+  currency?: string;
+}
+
+export function parseEmiParams(sp: SearchParams): EmiInitial {
+  const out: EmiInitial = {};
+  const amount = first(sp.amount);
+  const rate = first(sp.rate);
+  const years = first(sp.years);
+  const months = first(sp.months);
+  const currency = first(sp.currency)?.toUpperCase();
+  if (amount && NUMBER.test(amount)) out.amount = amount.replace(/,/g, '');
+  if (rate && SMALL_NUMBER.test(rate)) out.rate = rate;
+  if (years && SMALL_NUMBER.test(years)) { out.tenure = years; out.unit = 'years'; }
+  else if (months && /^[0-9]{1,3}$/.test(months)) { out.tenure = months; out.unit = 'months'; }
+  if (currency && ['INR', 'USD', 'GBP', 'EUR', 'NONE'].includes(currency)) out.currency = currency;
+  return out;
+}
+
+export interface CurrencyInitial {
+  amount?: string;
+  from?: string;
+  to?: string;
+}
+
+export function parseCurrencyParams(sp: SearchParams): CurrencyInitial {
+  const out: CurrencyInitial = {};
+  const amount = first(sp.amount);
+  const from = first(sp.from)?.toUpperCase();
+  const to = first(sp.to)?.toUpperCase();
+  if (amount && NUMBER.test(amount)) out.amount = amount.replace(/,/g, '');
+  if (from && /^[A-Z]{3}$/.test(from)) out.from = from;
+  if (to && /^[A-Z]{3}$/.test(to)) out.to = to;
+  return out;
+}
+
+/** `?pgn=` (a game) or `?fen=` (a position), limited to 8,000 characters. Parsing and legality are checked by the viewer. */
+export function parsePgnParam(sp: SearchParams): string | undefined {
+  const text = first(sp.pgn) ?? first(sp.fen);
+  if (!text) return undefined;
+  const trimmed = text.trim();
+  return trimmed.length > 0 && trimmed.length <= 8000 ? trimmed : undefined;
+}
+
+/** Builds a link to a tool with prefilled values (used by the agents page and by tests). */
+export function toolLink(path: string, params: Record<string, string | number>): string {
+  const q = new URLSearchParams();
+  for (const [k, v] of Object.entries(params)) q.set(k, String(v));
+  return `${path}?${q.toString()}`;
+}
